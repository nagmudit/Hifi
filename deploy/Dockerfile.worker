# syntax=docker/dockerfile:1
# Worker image. One machine per tenant, created through the Fly Machines API
# rather than by `fly deploy`, with a per-tenant volume mounted at /data.
#
# This image carries the tools a job needs: git for mirrors and worktrees, and
# from M3 a browser for Playwright screenshots. It deliberately does not carry
# any credential: those arrive sealed, per job.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates git curl \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/bot/package.json apps/bot/
COPY apps/worker/package.json apps/worker/
COPY apps/dashboard/package.json apps/dashboard/
COPY packages/agent/package.json packages/agent/
COPY packages/core/package.json packages/core/
COPY packages/crypto/package.json packages/crypto/
COPY packages/db/package.json packages/db/
COPY packages/github/package.json packages/github/
COPY packages/router/package.json packages/router/
COPY packages/vercel/package.json packages/vercel/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/worker apps/worker
RUN pnpm --filter @hifi/db generate \
 && pnpm -r --filter "./packages/**" build \
 && pnpm --filter @hifi/worker build

FROM base AS runtime
ENV NODE_ENV=production
# Per-tenant volume. Bare mirrors, the package store, and job worktrees all live
# here, and all three are disposable caches: losing the volume costs one slow
# job, never data.
ENV HIFI_DATA_DIR=/data
COPY --from=build /app /app
RUN mkdir -p /data && chown -R node:node /data
USER node
VOLUME ["/data"]
CMD ["node", "apps/worker/dist/index.js"]
