# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit a filled-in copy.
# Ports match docker-compose.yml, which deliberately avoids the defaults so it
# does not collide with a locally installed Postgres or Redis.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://hifi:hifi@localhost:55432/hifi?schema=public
REDIS_URL=redis://localhost:56379

# apps/api
API_PORT=8099
API_HOST=0.0.0.0
# Public origin of the API, used to build OAuth callback URLs.
PUBLIC_API_URL=http://localhost:8099
PUBLIC_DASHBOARD_URL=http://localhost:3000

# packages/crypto
# Generate with: pnpm --filter @hifi/crypto keygen
# The PUBLIC key goes everywhere: sealing a credential needs only this, so the
# API and dashboard can store a customer key they cannot read back.
# The SECRET key goes to workers only, as a Fly secret. Never ship it to the
# control plane, and never commit it.
HIFI_MASTER_PUBLIC_KEY=
HIFI_MASTER_SECRET_KEY=
HIFI_MASTER_KEY_VERSION=1

# --- Used from M2. How to obtain each one: docs/runbooks/dev-credentials.md --

# Discord application (one application serves every tenant)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# GitHub App (one app serves every tenant; never a personal access token).
# Locally, point at the downloaded .pem, kept OUTSIDE this repository.
# In production the key is a Fly secret in GITHUB_APP_PRIVATE_KEY instead.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=

# M2 single-tenant hardcoding. Replaced by real tenant rows at M4.
M2_DISCORD_GUILD_ID=
M2_DISCORD_CHANNEL_ID=
M2_GITHUB_INSTALLATION_ID=
M2_REPO_FULL_NAME=
# Any provider is supported by design (ADR-006). M2 develops against OpenAI.
M2_MODEL_PROVIDER=openai
M2_MODEL_API_KEY=
# Leave blank: chosen from the models the key can actually reach.
M2_MODEL_ID=
# Per-job budget, enforced by the model proxy between calls (ADR-008).
# Input plus output tokens. Re-check against the chosen model's price.
M2_JOB_TOKEN_CEILING=1000000

# --- Later milestones. Present so the shape is visible. --------------------

# Discord interactions and OAuth (M3 slash commands, M4 install flow)
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub webhooks (M3) and sign-in with GitHub (M4, ADR-007)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Cloudflare R2 (M3: attachments and screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe (M5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
