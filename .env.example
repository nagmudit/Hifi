# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit a filled-in copy.
# Ports match docker-compose.yml, which deliberately avoids the defaults so it
# does not collide with a locally installed Postgres or Redis.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://hifi:hifi@localhost:55432/hifi?schema=public
REDIS_URL=redis://localhost:56379

# apps/api
API_PORT=8099
API_HOST=0.0.0.0
# Public origin of the API, used to build OAuth callback URLs.
PUBLIC_API_URL=http://localhost:8099
PUBLIC_DASHBOARD_URL=http://localhost:3000

# packages/crypto
# Generate with: pnpm --filter @hifi/crypto keygen
# The PUBLIC key goes everywhere: sealing a credential needs only this, so the
# API and dashboard can store a customer key they cannot read back.
# The SECRET key goes to workers only, as a Fly secret. Never ship it to the
# control plane, and never commit it.
HIFI_MASTER_PUBLIC_KEY=
HIFI_MASTER_SECRET_KEY=
HIFI_MASTER_KEY_VERSION=1

# --- Not used until M2. Present so the shape is visible. -------------------

# Discord application (one application serves every tenant)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub App (one app serves every tenant; never a personal access token)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# M2 single-tenant hardcoding. Replaced by the Tenant table at M4.
M2_DISCORD_GUILD_ID=
M2_DISCORD_CHANNEL_ID=
M2_REPO_FULL_NAME=
M2_MODEL_PROVIDER=anthropic
M2_MODEL_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe (M5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
